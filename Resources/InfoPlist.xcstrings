    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay hält das Mikrofon offen, wenn du „Mikrofon bereit“ einschaltest. Der Ton wird sofort verworfen: Nichts wird aufgenommen, gespeichert oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay holds the microphone open when you switch on Warm Microphone. The sound is thrown away as it arrives: nothing is recorded, stored or sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay mantiene el micrófono abierto cuando activas Micrófono listo. El sonido se descarta en cuanto llega: no se graba, no se guarda y no se envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay garde le micro ouvert lorsque vous activez Micro prêt. Le son est jeté dès qu’il arrive : rien n’est enregistré, conservé ni envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay tiene aperto il microfono quando attivi Microfono pronto. L’audio viene scartato appena arriva: nulla viene registrato, salvato o inviato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay держит микрофон открытым, когда включён модуль «Микрофон наготове». Звук отбрасывается сразу: ничего не записывается, не сохраняется и не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“麦克风预热”后，Belay 会让麦克风保持开启。声音一到即被丢弃：不录制、不存储、不发送。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
