{
  "sourceLanguage" : "en",
  "strings" : {
    "NSDesktopFolderUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay liest diesen Ordner nur für das, wofür du es eingerichtet hast: ein hinzugefügtes Tool beobachten oder alte Bildschirmfotos in den Papierkorb legen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay reads this folder only for what you set it up to do: watching a tool you added, or moving old screenshots to the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay lee esta carpeta solo para lo que tú has configurado: vigilar una herramienta que añadiste o mover capturas de pantalla antiguas a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay lit ce dossier uniquement pour ce que vous avez configuré : surveiller un outil que vous avez ajouté ou placer les anciennes captures d'écran dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay legge questa cartella solo per ciò che hai configurato: osservare uno strumento che hai aggiunto o spostare nel Cestino le vecchie istantanee."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay читает эту папку только для того, что вы сами настроили: следить за добавленным инструментом или отправлять старые снимки экрана в Корзину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belay 读取此文件夹只为完成你设置的任务：监视你添加的工具，或将旧截屏移到废纸篓。"
          }
        }
      }
    },
