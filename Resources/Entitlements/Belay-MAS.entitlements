<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The user picks ~/.claude in an open panel; we keep it across launches
	     as an app-scoped bookmark. Both halves are required: the panel grant
	     without the bookmark dies at the next launch. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- Loopback listener for the Claude Code HTTP hook. Inbound only. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!--
	There is deliberately no com.apple.security.network.client. Belay has
	nothing to phone home to, and the missing entitlement is the proof we hand
	App Review when they ask about the listening socket (docs/06). Anything
	that would need it — Sparkle, analytics, a crash reporter — does not ship
	in this channel. Adding it is a product decision, not a build fix.
	-->
</dict>
</plist>
