    "Belay has saved %lld runs for you. A star on GitHub helps the next person find it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay hat %lld Läufe für dich gerettet. Ein Stern auf GitHub hilft dem Nächsten, es zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay has saved %lld runs for you. A star on GitHub helps the next person find it."
