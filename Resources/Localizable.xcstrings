    "Dims the display to this level during the hours below while you're away. Restores brightness when you return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Display in den unten angegebenen Stunden auf diese Stufe ab, während du weg bist. Stellt die Helligkeit wieder her, wenn du zurückkommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dims the display to this level during the hours below while you're away. Restores brightness when you return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa la pantalla a este nivel durante las horas indicadas abajo mientras no estás. Restaura el brillo cuando vuelves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténue l'écran à ce niveau pendant les heures ci-dessous en votre absence. Rétablit la luminosité à votre retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenua lo schermo a questo livello nelle ore indicate sotto mentre sei via. Ripristina la luminosità al tuo ritorno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет дисплей до указанного уровня по расписанию. Возвращает яркость, когда вы начинаете взаимодействовать с компьютером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你离开时，于下方设置的时段将显示器调暗到此亮度。你回来后恢复亮度。"
          }
        }
      }
    },
