{
  "sourceLanguage": "en",
  "strings": {
    "%@ has watched %lld agent runs on my Mac and kept it awake for %@ of them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %lld Agentenläufe auf meinem Mac beobachtet und ihn für %@ wach gehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ watched %lld agent runs on my Mac and kept it awake for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha observado %lld ejecuciones de agentes en mi Mac y lo ha mantenido despierto durante %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a suivi %lld exécutions d'agents sur mon Mac et l'a gardé éveillé pendant %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha seguito %lld esecuzioni di agenti sul mio Mac e lo ha tenuto sveglio per %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ следил за %lld запусками агентов на моём Mac и не давал ему уснуть в течение %@."
          }
        }
      }
    },
    "%@ held, %@ away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wach, %@ weg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ awake, %@ away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ despierto, %@ fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ éveillé, %@ absent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sveglio, %@ assente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ без сна, %@ без меня"
          }
        }
      }
    },
    "%@ kept my Mac awake for %@ while I was away from it, and saved %lld agent runs that would otherwise have died when the Mac went to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat meinen Mac %@ lang wach gehalten, während ich weg war, und %lld Agentenläufe vor einer Unterbrechung durch den Ruhezustand bewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kept my Mac awake for %@ while I was away and saved %lld agent runs from being interrupted by sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantuvo mi Mac despierto durante %@ mientras yo no estaba y evitó que el reposo interrumpiera %lld ejecuciones del agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a gardé mon Mac éveillé pendant %@ en mon absence et a évité que la veille n'interrompe %lld exécutions d'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tenuto sveglio il mio Mac per %@ mentre non c'ero e ha evitato che lo stop interrompesse %lld esecuzioni dell'agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не давал моему Mac уснуть в течение %@, пока меня не было, и не дал режиму сна прервать %lld запусков агента."
          }
        }
      }
    },
    "%@ kept my Mac awake for %@ while I was away from it, and saved 1 agent run that would otherwise have died when the Mac went to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat meinen Mac %@ lang wach gehalten, während ich weg war, und 1 Agentenlauf vor einer Unterbrechung durch den Ruhezustand bewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kept my Mac awake for %@ while I was away and saved 1 agent run from being interrupted by sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantuvo mi Mac despierto durante %@ mientras yo no estaba y evitó que el reposo interrumpiera 1 ejecución del agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a gardé mon Mac éveillé pendant %@ en mon absence et a évité que la veille n'interrompe 1 exécution d'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tenuto sveglio il mio Mac per %@ mentre non c'ero e ha evitato che lo stop interrompesse 1 esecuzione dell'agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не давал моему Mac уснуть в течение %@, пока меня не было, и не дал режиму сна прервать 1 запуск агента."
          }
        }
      }
    },
