      }
    },
    "Your Claude Code settings file is not plain JSON, so Belay will not modify it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Claude-Code-Einstellungsdatei ist kein reines JSON, deshalb ändert Belay sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Claude Code settings file isn't plain JSON, so Belay won't modify it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu archivo de ajustes de Claude Code no es JSON puro, así que Belay no lo modificará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fichier de réglages Claude Code n'est pas du JSON pur, Belay ne le modifiera donc pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
