    "Belay has saved %lld runs for you. A star on GitHub helps the next person find it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay hat %lld Läufe für dich gerettet. Ein Stern auf GitHub hilft dem Nächsten, es zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay has saved %lld runs for you. A star on GitHub helps the next person find it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ha salvado %lld ejecuciones tuyas. Una estrella en GitHub ayuda al siguiente a encontrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay a sauvé %lld exécutions pour vous. Une étoile sur GitHub aide le suivant à le trouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ha salvato %lld esecuzioni per te. Una stella su GitHub aiuta il prossimo a trovarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay спас для вас %lld запусков. Звезда на GitHub поможет следующему найти его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 已为你保住 %lld 次运行。在 GitHub 上加一颗星标，能帮下一个人找到它。"
          }
        }
      }
    },
    "Belay has to reopen to change language.": {
