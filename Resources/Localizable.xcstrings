          }
        }
      }
    },
    "Belay could not ask Codex to trust its hooks: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay konnte Codex nicht bitten, seinen Hooks zu vertrauen: %@"
          }
