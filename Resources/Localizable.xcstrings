    "One summary when you come back: how long Belay held, and how many runs finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zusammenfassung bei Ihrer Rückkehr: wie lange Belay gehalten hat und wie viele Läufe fertig wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One summary when you come back: how long Belay held, and how many runs finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen al volver: cuánto tiempo mantuvo Belay y cuántas ejecuciones terminaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résumé à votre retour : combien de temps Belay a tenu et combien d’exécutions se sont terminées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo al tuo ritorno: per quanto Belay ha tenuto sveglio e quante esecuzioni sono finite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сводка по возвращении: сколько Belay держал и сколько запусков завершилось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回时提供一份小结：Belay 保持唤醒了多久，完成了多少次运行。"
          }
        }
      }
    },
