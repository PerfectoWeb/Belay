    "On battery, Belay lets your Mac sleep at %lld%%.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Akkubetrieb lässt Belay den Mac bei %lld%% schlafen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On battery, Belay lets your Mac sleep at %lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con batería, Belay deja dormir el Mac al %lld%%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur batterie, Belay laisse le Mac se mettre en veille à %lld%%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A batteria, Belay lascia che il Mac vada in stop al %lld%%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При работе от батареи Belay разрешает Mac заснуть, когда заряд менее %lld%%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池时，电量降至 %lld%% 后 Belay 会让 Mac 进入睡眠。"
          }
        }
      }
    },
    "Once a day, Belay checks whether a newer version exists. It sends nothing about you, and nothing is downloaded or installed until you press Update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft einmal am Tag. Es werden keine persönlichen Daten gesendet. Nichts wird geladen oder installiert, bis du dich für das Update entscheidest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks once a day. No personal data is sent. Nothing is downloaded or installed until you choose to update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba una vez al día. No se envían datos personales. No se descarga ni instala nada hasta que decidas actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie une fois par jour. Aucune donnée personnelle n'est envoyée. Rien n'est téléchargé ni installé tant que vous ne choisissez pas de mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla una volta al giorno. Nessun dato personale viene inviato. Nulla viene scaricato o installato finché non scegli di aggiornare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка производится исключительно после вашего запуска обновления. Личные данные никуда не отправляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天检查一次。不发送任何个人数据。在你选择更新之前，不会下载或安装任何内容。"
          }
        }
      }
    },
