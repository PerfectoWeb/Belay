    "Keeps your Mac awake with the lid closed. Ends at the awake limit or if your Mac gets too warm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Mac mit geschlossenem Deckel wach. Endet am Wachlimit oder wenn der Mac zu warm wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your Mac awake with the lid closed. Ends at the awake limit or if your Mac gets too warm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac despierto con la tapa cerrada. Termina al llegar al límite de vigilia o si el Mac se calienta demasiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
