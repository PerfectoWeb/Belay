    "The App Store keeps Belay up to date and tells you when a new version is ready. Belay itself makes no network connections at all.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hält Belay aktuell und sagt dir, wenn eine neue Version bereit ist. Belay selbst stellt überhaupt keine Netzwerkverbindungen her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store keeps Belay up to date and tells you when a new version is ready. Belay itself makes no network connections at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store mantiene Belay al día y te avisa cuando hay una versión nueva. Belay no hace ninguna conexión de red por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store garde Belay à jour et vous prévient quand une nouvelle version est prête. Belay ne fait lui-même aucune connexion réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store tiene Belay aggiornato e ti avvisa quando è pronta una nuova versione. Belay non effettua alcuna connessione di rete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store обновляет Belay сам и сообщает, когда готова новая версия. Само приложение сетевых запросов не делает вовсе."
          }
        }
      }
    },
