      }
    },
    "A session appears here once it ends, if it ran for at least a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung erscheint hier nach ihrem Ende, wenn sie mindestens eine Minute lief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session appears here once it ends, if it ran for at least a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión aparece aquí al terminar, si duró al menos un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session apparaît ici une fois terminée, si elle a duré au moins une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione compare qui quando termina, se è durata almeno un minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия появится здесь после завершения, если проработала хотя бы минуту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话结束后会显示在这里（至少运行一分钟）。"
          }
        }
      }
    },
    "A session goes quiet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung verstummt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session goes quiet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión se queda en silencio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session se tait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione resta in silenzio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия замолчала"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话没有动静时"
          }
        }
      }
    },
    "A session stopped responding without finishing, usually because the CLI needs input or was closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung antwortet nicht mehr, ohne fertig zu sein. Meist wartet die CLI auf Eingabe oder wurde geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session stopped responding without finishing, usually because the CLI needs input or was closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión dejó de responder sin terminar, normalmente porque la CLI espera una entrada o se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session a cessé de répondre sans terminer, généralement parce que la CLI attend une saisie ou a été fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione ha smesso di rispondere senza finire, di solito perché la CLI attende un input o è stata chiusa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия перестала отвечать, не завершившись. Обычно CLI ждёт ввода или был закрыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话尚未完成就停止了响应，通常是 CLI 在等待输入或已被关闭。"
          }
        }
      }
    },
    "A session that has finished is no longer reported as gone quiet a quarter of an hour later, whatever gets written to its transcript afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine fertige Sitzung wird nicht mehr eine Viertelstunde später als verstummt gemeldet, egal was danach in ihr Protokoll geschrieben wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session that has finished is no longer reported as gone quiet a quarter of an hour later, whatever gets written to its transcript afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión que ha terminado ya no se informa como en silencio un cuarto de hora después, se escriba lo que se escriba luego en su transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session terminée n'est plus signalée comme silencieuse un quart d'heure plus tard, quoi qu'il s'écrive ensuite dans sa transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione conclusa non viene più segnalata come silenziosa un quarto d'ora dopo, qualunque cosa venga scritta poi nella sua trascrizione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённая сессия больше не объявляется затихшей через четверть часа, что бы ни дописывалось в её журнал после."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的会话不会再在一刻钟后被报告为没有动静，无论之后向其记录中写入什么。"
          }
        }
      }
    },
    "A session waits for you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung wartet auf dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session waits for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión te espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session vous attend"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione ti aspetta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия ждёт вас"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话等待你回应时"
          }
        }
      }
    },
    "A short note when you change mode by hand. Turning off interface sounds in System Settings silences these too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen kurzen Ton, wenn du den Modus manuell wechselst. Beachtet deine Systemeinstellungen für Töne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short sound when you change modes manually. Respects your system sound settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un sonido corto al cambiar de modo manualmente. Respeta los ajustes de sonido del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue un son bref quand vous changez de mode manuellement. Respecte les réglages sonores du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve suono quando cambi modalità manualmente. Rispetta le impostazioni audio di sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нейтральное звуковое сопровождение по интерфейсу. Учитывает настройки системных звуков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动切换模式时播放短促提示音。遵循系统声音设置。"
          }
        }
      }
    },
    "A sound and a reminder when an agent finishes or waits for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton und Erinnerung, wenn ein Agent fertig ist oder auf dich wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sound and a reminder when an agent finishes or waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonido y recordatorio cuando un agente termina o te espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un son et un rappel quand un agent a terminé ou vous attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suono e un promemoria quando un agente ha finito o ti aspetta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук и напоминание, когда агент закончил или ждёт вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体完成或等待你时发出声音并提醒。"
          }
        }
      }
    },
    "A timestamped backup is made first. Everything already in the file is preserved, and \"Remove\" puts it back exactly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay legt zuerst eine Sicherung mit Zeitstempel an. „Entfernen“ stellt die ursprüngliche Datei wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay makes a timestamped backup first. \"Remove\" restores the original file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay crea primero una copia de seguridad con fecha y hora. «Quitar» restaura el archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay crée d'abord une sauvegarde horodatée. « Retirer » restaure le fichier d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay crea prima una copia di sicurezza con data e ora. «Rimuovi» ripristina il file originale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay создаёт резервную копию вашей конфигурации при включении и возвращает её при отключении точного определения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 会先创建带时间戳的备份。“移除”会还原原始文件。"
          }
        }
      }
    },
