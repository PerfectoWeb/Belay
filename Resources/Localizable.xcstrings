    "Show what a working agent is doing – running a command, editing files – next to its state. Requires Precise Detection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt neben dem Status, was ein arbeitender Agent gerade tut – Befehl ausführen, Dateien bearbeiten. Erfordert präzise Erkennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
