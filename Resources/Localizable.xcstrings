    },
    "Belay expected to find \"%@\" inside. You can watch it anyway, and it will simply stay quiet until %@ writes there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay hat darin \"%@\" erwartet. Du kannst ihn trotzdem beobachten, er bleibt einfach still, bis %@ dort schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay expected to find \"%@\" inside. You can watch it anyway, and it will simply stay quiet until %@ writes there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay esperaba encontrar \"%@\" dentro. Puedes vigilarla de todos modos, simplemente quedará en silencio hasta que %@ escriba ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay s'attendait à trouver \"%@\" dedans. Vous pouvez quand même le surveiller, il restera simplement silencieux jusqu'à ce que %@ y écrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay si aspettava di trovare \"%@\" al suo interno. Puoi comunque osservarla, resterà semplicemente in silenzio finché %@ non ci scriverà."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ожидал найти внутри \"%@\". Можно всё равно следить за ней: она просто будет молчать, пока %@ туда не начнёт писать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 预期其中包含\"%@\"。你仍可以监视它，在 %@ 向其写入之前它只会保持安静。"
          }
        }
      }
    },
    "Belay has no access to the microphone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay hat keinen Zugriff auf das Mikrofon."
