          }
        }
      }
    },
    "Belay could not back up your Claude Code settings, so it made no changes: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay konnte deine Claude-Code-Einstellungen nicht sichern. Deshalb wurde nichts geändert: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay couldn't back up your Claude Code settings, so nothing was changed: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay no pudo hacer una copia de seguridad de tus ajustes de Claude Code, así que no cambió nada: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay n'a pas pu sauvegarder vos réglages Claude Code. Rien n'a donc été modifié : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay non ha potuto fare una copia di sicurezza delle impostazioni di Claude Code, quindi non ha modificato nulla: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay не смог сохранить резервную копию настроек Claude Code, поэтому ничего не изменил: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 无法备份 Claude Code 设置，因此未做任何更改：%@"
          }
        }
      }
    },
    "Belay could not migrate preferences from version %lld.": {
      "extractionState": "manual",
