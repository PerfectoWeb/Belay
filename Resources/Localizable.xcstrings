            "state": "translated",
            "value": "距现在 %@"
          }
        }
      }
    },
    "%@ has watched %lld agent runs on my Mac and kept it awake for %@ of them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %lld Agentenläufe auf meinem Mac beobachtet und ihn für %@ wach gehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ watched %lld agent runs on my Mac and kept it awake for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha observado %lld ejecuciones de agentes en mi Mac y lo ha mantenido despierto durante %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a suivi %lld exécutions d'agents sur mon Mac et l'a gardé éveillé pendant %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha seguito %lld esecuzioni di agenti sul mio Mac e lo ha tenuto sveglio per %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ следил за %lld запусками агентов на моём Mac и не давал ему уснуть в течение %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在我的 Mac 上监视了 %lld 次智能体运行，并让它保持唤醒 %@。"
          }
        }
      }
    },
    "%@ held, %@ away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wach, %@ weg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ awake, %@ away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ despierto, %@ fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ éveillé, %@ absent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sveglio, %@ assente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ без сна, %@ без меня"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒 %@，离开 %@"
          }
        }
      }
    },
    "%@ is switched off in Agents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist unter Agenten ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is switched off in Agents."
          }
        },
