    "%@ and %@ are switched off in Agents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@ sind unter Agenten ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ are switched off in Agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ están desactivados en Agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %@ sont désactivés dans Agents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e %@ sono disattivati in Agenti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ и %@ выключены во вкладке «Агенты»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和 %@ 已在“智能体”中关闭。"
          }
        }
      }
    },
    "%@ from now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@"
          }
        },
