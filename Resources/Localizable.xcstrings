    "Your agent is blocked on a permission prompt or a question. This one needs precise detection turned on to be reliable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Agent wartet auf eine Berechtigungsabfrage oder eine Antwort. Für zuverlässige Mitteilungen ist die präzise Erkennung erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent is waiting on a permission prompt or question. Precise detection is required for reliable notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu agente está esperando una solicitud de permiso o una respuesta. La detección precisa es necesaria para recibir avisos fiables."
          }
        },
        "fr": {
          "stringUnit": {
