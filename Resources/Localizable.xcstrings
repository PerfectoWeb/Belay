          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行完成时"
          }
        }
      }
    },
    "A run finishes, naming its workspace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
