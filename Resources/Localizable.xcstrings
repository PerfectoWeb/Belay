    "of agent work while I was away. Sleep would have interrupted %lld of those runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentenarbeit, während ich weg war. %lld dieser Läufe hätte der Ruhezustand unterbrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "of agent work while I was away. Sleep would have interrupted %lld of those runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "de trabajo del agente mientras yo no estaba. El reposo habría interrumpido %lld de esas ejecuciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "de travail de l'agent pendant mon absence. La veille aurait interrompu %lld de ces exécutions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "di lavoro dell'agente mentre non c'ero. Lo stop avrebbe interrotto %lld di quelle esecuzioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "работы агента, пока меня не было. Прогонов, которые прервал бы сон: %lld."
          }
        }
      }
    },
