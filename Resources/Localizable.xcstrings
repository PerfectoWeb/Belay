    "A Bluetooth microphone, such as AirPods, is not held. Holding it keeps the headphones in call mode, which lowers the quality of what you listen to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bluetooth-Mikrofon, etwa das der AirPods, wird nicht offen gehalten. Sonst bleiben die Kopfhörer im Anrufmodus, was die Qualität dessen senkt, was du hörst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bluetooth microphone, such as AirPods, is not held. Holding it keeps the headphones in call mode, which lowers the quality of what you listen to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un micrófono Bluetooth, como el de los AirPods, no se mantiene abierto. Mantenerlo deja los auriculares en modo llamada, lo que reduce la calidad de lo que escuchas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un micro Bluetooth, comme celui des AirPods, n'est pas maintenu ouvert. Le maintenir laisse les écouteurs en mode appel, ce qui réduit la qualité de ce que vous écoutez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un microfono Bluetooth, come quello degli AirPods, non viene tenuto aperto. Tenerlo aperto lascia le cuffie in modalità chiamata, il che abbassa la qualità di ciò che ascolti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон Bluetooth, например в AirPods, не удерживается. Иначе наушники остаются в режиме разговора, из-за чего качество звука в них ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保持 AirPods 等蓝牙麦克风开启。保持开启会让耳机停留在通话模式，播放音质因此下降。"
          }
        }
      }
    },
    "A GitHub star helps others find it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein GitHub-Stern hilft anderen, es zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub star helps others find it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estrella en GitHub ayuda a otros a encontrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étoile GitHub aide les autres à le trouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stella su GitHub aiuta gli altri a trovarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звезда на GitHub помогает другим его найти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 星标能帮助其他人找到它。"
          }
        }
      }
    },
    "A process an agent started that keeps a core busy while none of the sessions of that agent is working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Prozess, den ein Agent gestartet hat und der einen Kern auslastet, während keine Sitzung dieses Agents arbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A process an agent started that keeps a core busy while none of the sessions of that agent is working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proceso iniciado por un agente que mantiene un núcleo ocupado mientras ninguna sesión de ese agente está trabajando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un processus lancé par un agent qui occupe un cœur alors qu'aucune session de cet agent ne travaille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un processo avviato da un agente che tiene occupato un core mentre nessuna sessione di quell'agente sta lavorando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс, запущенный агентом, который загружает ядро, пока ни одна сессия этого агента не работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由智能体启动的进程，在该智能体没有任何会话工作时仍占满一个核心。"
          }
        }
      }
    },
    "A run finishes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lauf endet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A run finishes"
