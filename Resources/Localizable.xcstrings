    "Belay could not read its preferences and has fallen back to defaults.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay konnte seine Einstellungen nicht lesen und verwendet deshalb die Standardwerte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay couldn't read its settings, so it's using the defaults."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay no pudo leer sus ajustes, así que está usando los valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
