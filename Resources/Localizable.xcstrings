{
  "sourceLanguage": "en",
  "strings": {
    "%@ has watched %lld agent runs on my Mac and kept it awake for %@ of them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %lld Agentenläufe auf meinem Mac beobachtet und ihn dabei %@ lang wach gehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has watched %lld agent runs on my Mac and kept it awake for %@ of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha vigilado %lld ejecuciones de agentes en mi Mac y lo ha mantenido despierto %@ de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a surveillé %lld exécutions d'agents sur mon Mac et l'a gardé éveillé %@ d'entre elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha osservato %lld esecuzioni di agenti sul mio Mac e lo ha tenuto sveglio %@ di quelle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ проследил за %lld прогонами агентов на моём Mac и продержал его бодрым %@ из них."
          }
        }
      }
    },
    "%@ held, %@ away": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehalten, %@ abwesend"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ held, %@ away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantenido, %@ ausente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ maintenu, %@ absent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantenuto, %@ assente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "удержано %@, без вас %@"
          }
        }
      }
    },
    "%@ kept my Mac awake for %@ while I was away from it, and saved %lld agent runs that would otherwise have died when the Mac went to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat meinen Mac %@ lang wach gehalten, während ich weg war, und %lld Agentenläufe gerettet, die sonst im Ruhezustand gestorben wären."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kept my Mac awake for %@ while I was away from it, and saved %lld agent runs that would otherwise have died when the Mac went to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantuvo mi Mac despierto %@ mientras yo no estaba y salvó %lld ejecuciones de agente que habrían muerto al dormirse el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a gardé mon Mac éveillé %@ pendant mon absence et a sauvé %lld exécutions d'agent qui seraient mortes à la mise en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tenuto sveglio il mio Mac per %@ mentre non c'ero e ha salvato %lld esecuzioni che sarebbero morte con il Mac in stop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ держал мой Mac бодрым %@, пока меня не было, и спас прогонов агентов: %lld, которые иначе умерли бы, когда Mac уснёт."
          }
        }
      }
    },
    "%@ kept my Mac awake for %@ while I was away from it, and saved 1 agent run that would otherwise have died when the Mac went to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat meinen Mac %@ lang wach gehalten, während ich weg war, und 1 Agentenlauf gerettet, der sonst im Ruhezustand gestorben wäre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kept my Mac awake for %@ while I was away from it, and saved 1 agent run that would otherwise have died when the Mac went to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mantuvo mi Mac despierto %@ mientras yo no estaba y salvó 1 ejecución de agente que habría muerto al dormirse el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a gardé mon Mac éveillé %@ pendant mon absence et a sauvé 1 exécution d'agent qui serait morte à la mise en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tenuto sveglio il mio Mac per %@ mentre non c'ero e ha salvato 1 esecuzione che sarebbe morta con il Mac in stop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ держал мой Mac бодрым %@, пока меня не было, и спас 1 прогон агента, который иначе умер бы, когда Mac уснёт."
          }
        }
      }
    },
