    "Belay asks macOS for permission the first time it actually needs to notify you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay fragt beim ersten Senden einer Mitteilung nach der Erlaubnis für Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay asks for notification permission the first time it needs to send one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay pide permiso para enviar notificaciones la primera vez que necesita enviar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay demande l'autorisation d'envoyer des notifications la première fois qu'il doit en envoyer une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay chiede il permesso per le notifiche la prima volta che deve inviarne una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
