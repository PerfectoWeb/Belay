    "Belay already watches this folder for %@, or one that contains it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay beobachtet diesen Ordner für %@ bereits, oder einen, der ihn enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay already watches this folder for %@, or one that contains it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ya vigila esta carpeta para %@, o una que la contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay surveille déjà ce dossier pour %@, ou un dossier qui le contient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay osserva già questa cartella per %@, o una che la contiene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay уже следит за этой папкой для %@ или за папкой, которая её содержит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 已经在为 %@ 监视此文件夹，或包含它的文件夹。"
          }
        }
      }
    },
    "Belay also records these hooks as approved in Codex's config.toml, because Codex quietly skips hooks nobody has approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay vermerkt diese Hooks außerdem als genehmigt in der config.toml, denn Codex überspringt nicht genehmigte Hooks stillschweigend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay also records these hooks as approved in Codex's config.toml, because Codex quietly skips hooks nobody has approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay también registra estos hooks como aprobados en config.toml, porque Codex omite en silencio los hooks no aprobados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay note aussi ces hooks comme approuvés dans config.toml, car Codex ignore en silence les hooks non approuvés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay registra anche questi hook come approvati in config.toml, perché Codex ignora in silenzio gli hook non approvati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки помечаются как одобренные в config.toml, потому что Codex молча пропускает неодобренные хуки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 还会在 config.toml 中将这些钩子标记为已批准，因为 Codex 会静默跳过未批准的钩子。"
          }
        }
      }
    },
    "Belay asks for permission the first time it needs to send a notification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay bittet beim ersten Mal um Erlaubnis, wenn eine Mitteilung gesendet werden muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay asks for permission the first time it needs to send a notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay pide permiso la primera vez que necesita enviar una notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay demande l'autorisation la première fois qu'il doit envoyer une notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay chiede il permesso la prima volta che deve inviare una notifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay запросит разрешение, когда впервые понадобится отправить уведомление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 会在首次需要发送通知时请求权限。"
          }
        }
      }
    },
    "Belay asks it to quit and does nothing more. Whatever it has not saved is lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay bittet den Prozess, sich zu beenden, und tut sonst nichts. Was er nicht gesichert hat, geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay asks it to quit and does nothing more. Whatever it has not saved is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay le pide que se cierre y no hace nada más. Lo que no haya guardado se pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay lui demande de se terminer et ne fait rien d'autre. Ce qu'il n'a pas enregistré est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay gli chiede di chiudersi e non fa altro. Ciò che non ha salvato va perso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay просит процесс завершиться и больше ничего не делает. Всё несохранённое будет потеряно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 只会请求它退出，不会做其他操作。尚未保存的内容将丢失。"
          }
        }
      }
    },
    "Belay can see your agent's sessions.\nNothing else is read, and nothing leaves this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay sieht die Sitzungen deines Agenten.\nMehr wird nicht gelesen, und nichts verlässt diesen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay can see your agent's sessions.\nNothing else is read, and nothing leaves this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ve las sesiones de tu agente.\nNo lee nada más y nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay voit les sessions de votre agent.\nRien d'autre n'est lu, et rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay vede le sessioni del tuo agente.\nNon legge altro e nulla lascia questo Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay видит сессии вашего агента.\nБольше он ничего не читает, и ничего не покидает этот Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay 可以看到智能体的会话。\n其他内容一概不读，也没有任何内容离开这台 Mac。"
          }
        }
      }
    },
    "Belay cannot read %@. Choose the folder again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay kann %@ nicht lesen. Wähle den Ordner erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay cannot read %@. Choose the folder again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay no puede leer %@. Vuelve a elegir la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay ne peut pas lire %@. Choisissez de nouveau le dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay non riesce a leggere %@. Scegli di nuovo la cartella."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Belay не может прочитать %@. Выберите папку заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
