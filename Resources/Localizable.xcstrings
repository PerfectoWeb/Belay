    "Watches Claude Code's session transcripts to tell when a turn is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtet die Sitzungsprotokolle von Claude Code, um zu erkennen, wann ein Zug läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watches Claude Code's session transcripts to tell when a turn is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa las transcripciones de sesión de Claude Code para saber cuándo hay un turno en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveille les transcriptions de session de Claude Code pour savoir quand un tour est en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva le trascrizioni di sessione di Claude Code per capire quando un turno è in corso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за транскриптами сессий Claude Code, чтобы понимать, идёт ли ход."
          }
        }
      }
    },
    "Watches a folder you choose, or listens for a one-line webhook, so any coding agent can hold the Mac awake. Start from a preset or add your own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtet einen von dir gewählten Ordner oder lauscht auf einen einzeiligen Webhook, damit jeder Coding-Agent den Mac wach halten kann. Starte mit einer Vorlage oder füge eigene hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watches a folder you choose, or listens for a one-line webhook, so any coding agent can hold the Mac awake. Start from a preset or add your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa una carpeta que elijas o escucha un webhook de una línea, para que cualquier agente pueda mantener el Mac despierto. Empieza con un preajuste o añade el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveille un dossier de votre choix, ou écoute un webhook d'une ligne, pour que n'importe quel agent puisse garder le Mac éveillé. Partez d'un préréglage ou ajoutez le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva una cartella che scegli, o ascolta un webhook di una riga, così qualsiasi agente può tenere sveglio il Mac. Parti da un preset o aggiungi il tuo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за выбранной вами папкой или слушает однострочный вебхук, чтобы любой агент мог держать Mac бодрым. Начните с пресета или добавьте своё."
          }
        }
      }
    },
    "Welcome to %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei %@"
          }
