          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra qué hace un agente en marcha – ejecutar un comando, editar archivos – junto a su estado. Requiere detección precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ce que fait un agent au travail – exécuter une commande, modifier des fichiers – à côté de son état. Nécessite la détection précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cosa sta facendo un agente al lavoro – eseguire un comando, modificare file – accanto al suo stato. Richiede il rilevamento preciso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать, чем занят работающий агент – выполняет команду, редактирует файлы – рядом с его состоянием. Требуется точное определение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在状态旁边显示工作中的智能体正在做什么：运行命令、编辑文件等。需要精确检测。"
          }
        }
      }
    },
