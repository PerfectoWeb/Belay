    "Watches a folder you choose, or listens for a one-line webhook, so any coding agent can hold the Mac awake. Start from a preset or add your own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachte einen Ordner oder nutze einen einzeiligen Webhook für einen weiteren Coding-Agenten. Starte mit einer Vorlage oder füge eine eigene hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch a folder or use a one-line webhook to support another coding agent. Start with a preset or add your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Belaya una carpeta o usa un webhook de una línea para otro agente de programación. Empieza con un preajuste o añade el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez un dossier ou utilisez un webhook d'une ligne pour prendre en charge un autre agent de programmation. Commencez avec un préréglage ou ajoutez le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora una cartella o usa un webhook di una riga per supportare un altro agente di programmazione. Parti da un preset o aggiungi il tuo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за папкой или используйте однострочный вебхук для другого агента. Начните с пресета или добавьте свой."
          }
        }
      }
    },
    "Welcome to %@": {
      "extractionState": "manual",
      "localizations": {
