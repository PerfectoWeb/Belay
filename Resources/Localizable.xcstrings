    "An agent is waiting for you. Vigil is keeping your Mac awake.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent wartet auf dich. Vigil hält deinen Mac wach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent is waiting for you. Vigil is keeping your Mac awake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente te espera. Vigil mantiene el Mac despierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent vous attend. Vigil garde votre Mac éveillé."
          }
        },
