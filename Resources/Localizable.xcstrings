          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exécution se termine, avec le nom du projet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finisce un'esecuzione, con il nome del progetto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
