    "Keeping the display off saves power and won't interrupt your agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeschaltetes Display spart Strom und unterbricht deinen Agenten nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping the display off saves power and won't interrupt your agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la pantalla apagada ahorra energía y no interrumpe a tu agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder l'écran éteint économise l'énergie et n'interrompt pas votre agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere lo schermo spento risparmia energia e non interrompe il tuo agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
