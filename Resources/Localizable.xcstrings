    "Battery is at %lld%%, so Belay stopped keeping your Mac awake.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akku bei %lld%%. Belay hält deinen Mac nicht mehr wach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery reached %lld%%. Belay stopped keeping your Mac awake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería al %lld%%. Belay dejó de mantener el Mac despierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie à %lld%%. Belay a cessé de garder votre Mac éveillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteria al %lld%%. Belay ha smesso di tenere sveglio il Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд %lld%%. Belay разрешил Mac уснуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量降至 %lld%%。Belay 已停止保持唤醒。"
          }
        }
      }
    },
    "Behaviour": {
      "extractionState": "manual",
