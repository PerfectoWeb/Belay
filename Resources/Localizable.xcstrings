    "An agent is working. Your Mac will be free to sleep as soon as Belay quits.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent arbeitet. Wenn du Belay beendest, darf dein Mac schlafen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent is working. Quitting Belay will let your Mac sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un agente trabajando. Si cierras Belay, el Mac podrá entrar en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent travaille. Quitter Belay permettra à votre Mac de se mettre en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente sta lavorando. Se chiudi Belay, il Mac potrà andare in stop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент работает. Если закрыть Belay, Mac сможет уснуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体正在工作。退出 Belay 会让 Mac 进入睡眠。"
          }
        }
      }
    },
    "An agent works, Belay holds the Mac awake, and the Mac sleeps once the work stops": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent arbeitet, Belay hält den Mac wach, und wenn die Arbeit endet, schläft der Mac"
