    "The App Store keeps Belay up to date and tells you when a new version is ready. Belay itself never connects out to the internet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hält Belay aktuell und sagt dir, wenn eine neue Version bereit ist. Belay selbst verbindet sich nie ins Internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store keeps Belay up to date and tells you when a new version is ready. Belay itself never connects out to the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store mantiene Belay al día y te avisa cuando hay una versión nueva. Belay nunca se conecta a internet por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store garde Belay à jour et vous prévient quand une nouvelle version est prête. Belay ne se connecte jamais à internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store tiene Belay aggiornato e ti avvisa quando è pronta una nuova versione. Belay non si connette mai a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store обновляет Belay сам и сообщает, когда готова новая версия. Само приложение наружу в интернет не ходит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 会让 Belay 保持最新，并在新版本就绪时通知你。Belay 自身从不连接互联网。"
          }
        }
      }
    },
    "The Mac ran hot for a while.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac lief eine Weile heiß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac ran hot for a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac estuvo caliente durante un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a chauffé pendant un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac è rimasto caldo per un po'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое-то время Mac работал с перегревом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 有一段时间温度较高。"
          }
        }
      }
    },
    "The Mac ran hot with the lid closed, so Belay let it sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac wurde mit geschlossenem Deckel zu warm, also hat Belay ihn schlafen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac ran hot with the lid closed, so Belay let it sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac se calentó demasiado con la tapa cerrada, así que Belay lo dejó dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a trop chauffé capot fermé, alors Belay l'a laissé dormir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac si è scaldato troppo a coperchio chiuso, così Belay lo ha lasciato dormire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac перегрелся с закрытой крышкой, и Belay дал ему уснуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖后 Mac 过热，Belay 已让它进入睡眠。"
          }
        }
      }
    },
