# Xcode
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated by XcodeGen — never hand-edit, never commit.
Belay.xcodeproj/

# SwiftPM
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Release artefacts
*.dmg
*.pkg
dist/

# Working notes kept out of the published history.
.attic/

# Local secrets. Nothing in here may ever be committed, pushed or uploaded.
# .secrets/ holds the App Store Connect API key (.p8) used for notarization.
.secrets/
*.p8
*.p12
*.cer
*.certSigningRequest
*.provisionprofile
.env
**/AuthKey_*.p8

# Promotional material
#
# The covers are committed: they are a few megabytes of final artwork and it is
# useful to know which version of them shipped with which release.
#
# The footage is not, and must not be. ProRes does not delta-compress, so every
# re-export adds its whole size to the repository for ever, and git has no way
# to forget it afterwards. 226 MB of it as of the first release. Video belongs
# on a release asset or outside the repository.
Promo/video-footage/

# Layered artwork from other people's kits, kept locally as the source the
# exports came from. Apple's MacBook bezel alone is 16 MB, and nothing in the
# build reads it: what ships is the flattened PNG beside it and the small
# imageset cut from that.
Promo/**/*.psd
.DS_Store
